rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-all default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidWatchHistory(data) {
      return data.keys().hasAll(['userId', 'mediaId', 'mediaType', 'title', 'watchedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.mediaId is string && data.mediaId.size() <= 64 &&
        data.mediaType is string && data.mediaType.size() <= 32 &&
        data.title is string && data.title.size() <= 256 &&
        data.watchedAt is string &&
        (!('posterPath' in data) || (data.posterPath is string && data.posterPath.size() <= 256)) &&
        (!('progress' in data) || data.progress is number) &&
        (!('duration' in data) || data.duration is number);
    }

    function isValidFavorite(data) {
      return data.keys().hasAll(['userId', 'mediaId', 'mediaType', 'title', 'addedAt']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.mediaId is string && data.mediaId.size() <= 64 &&
        data.mediaType is string && data.mediaType.size() <= 32 &&
        data.title is string && data.title.size() <= 256 &&
        data.addedAt is string &&
        (!('posterPath' in data) || (data.posterPath is string && data.posterPath.size() <= 256));
    }

    // Test connection document for initial handshake
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Watch history collection
    match /watch_history/{historyId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(historyId) && isValidWatchHistory(request.resource.data);
      allow update: if isSignedIn() && isValidId(historyId) &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        isValidWatchHistory(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Favorites collection
    match /favorites/{favoriteId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(favoriteId) && isValidFavorite(request.resource.data);
      allow update: if isSignedIn() && isValidId(favoriteId) &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        isValidFavorite(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
