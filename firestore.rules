rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tv_rooms/{roomCode} {
      allow read, write: if true;
    }
    match /remote_sessions/{sessionCode} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
