{
  "entities": {
    "WatchHistoryItem": {
      "title": "Watch History Item",
      "description": "Represents a media item watched by the user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the user who watched this media",
          "maxLength": 128
        },
        "mediaId": {
          "type": "string",
          "description": "Identifier of the media",
          "maxLength": 64
        },
        "mediaType": {
          "type": "string",
          "description": "Type of media: movie, tv, anime",
          "maxLength": 32
        },
        "title": {
          "type": "string",
          "description": "Title of the media",
          "maxLength": 256
        },
        "posterPath": {
          "type": "string",
          "description": "Relative poster image path",
          "maxLength": 256
        },
        "watchedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the media was last watched"
        },
        "progress": {
          "type": "number",
          "description": "Playback progress in seconds"
        },
        "duration": {
          "type": "number",
          "description": "Total duration in seconds"
        }
      },
      "required": ["userId", "mediaId", "mediaType", "title", "watchedAt"]
    },
    "FavoriteItem": {
      "title": "Favorite Item",
      "description": "A bookmarked or favorite movie, show, or anime",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the user who saved this item",
          "maxLength": 128
        },
        "mediaId": {
          "type": "string",
          "description": "Identifier of the media",
          "maxLength": 64
        },
        "mediaType": {
          "type": "string",
          "description": "Type of media",
          "maxLength": 32
        },
        "title": {
          "type": "string",
          "description": "Title of the media",
          "maxLength": 256
        },
        "posterPath": {
          "type": "string",
          "description": "Relative poster image path",
          "maxLength": 256
        },
        "addedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when added to favorites"
        }
      },
      "required": ["userId", "mediaId", "mediaType", "title", "addedAt"]
    }
  },
  "firestore": {
    "/watch_history/{historyId}": {
      "schema": "WatchHistoryItem",
      "description": "Collection of watch history entries"
    },
    "/favorites/{favoriteId}": {
      "schema": "FavoriteItem",
      "description": "Collection of saved favorites"
    }
  }
}
