{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique identifier of the user", "maxLength": 128 },
        "email": { "type": "string", "description": "User email address", "maxLength": 256 },
        "displayName": { "type": "string", "description": "Display name of the user", "maxLength": 128 },
        "createdAt": { "type": "string", "description": "Creation timestamp", "maxLength": 64 }
      },
      "required": ["userId", "email"]
    },
    "PlayerSettings": {
      "title": "Player Settings",
      "description": "User customized player options",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID", "maxLength": 128 },
        "skin": { "type": "string", "description": "Player skin ID", "maxLength": 64 },
        "autoplay": { "type": "boolean", "description": "Autoplay state" },
        "subtitles": { "type": "boolean", "description": "Subtitles state" },
        "welcomePage": { "type": "boolean", "description": "Show welcome modal" },
        "defaultVolume": { "type": "number", "description": "Default volume 0-100" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp", "maxLength": 64 }
      },
      "required": ["userId", "skin", "autoplay", "subtitles"]
    },
    "CustomMedia": {
      "title": "Custom Media Stream",
      "description": "User saved streams and bookmarks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique stream ID", "maxLength": 128 },
        "userId": { "type": "string", "description": "Owner user ID", "maxLength": 128 },
        "title": { "type": "string", "description": "Media title", "maxLength": 256 },
        "embedUrl": { "type": "string", "description": "Embed iframe or stream URL", "maxLength": 2048 },
        "type": { "type": "string", "description": "movie or series", "maxLength": 64 },
        "createdAt": { "type": "string", "description": "Created timestamp", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "embedUrl", "type"]
    },
    "RemoteSession": {
      "title": "Remote Control Session",
      "description": "Real-time sync room between player monitor and mobile/detached remote",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "description": "Unique session code", "maxLength": 128 },
        "hostUserId": { "type": "string", "description": "User ID who created the session", "maxLength": 128 },
        "isPlaying": { "type": "boolean", "description": "Playback active status" },
        "currentTime": { "type": "number", "description": "Current position in seconds" },
        "duration": { "type": "number", "description": "Total duration in seconds" },
        "volume": { "type": "number", "description": "Volume percentage 0 to 100" },
        "isMuted": { "type": "boolean", "description": "Audio mute status" },
        "mediaTitle": { "type": "string", "description": "Current media title", "maxLength": 256 },
        "mediaUrl": { "type": "string", "description": "Current media URL", "maxLength": 2048 },
        "lastCommand": { "type": "string", "description": "Latest transport command", "maxLength": 64 },
        "lastCommandValue": { "type": "number", "description": "Numeric value for command if applicable" },
        "updatedAt": { "type": "string", "description": "Last heartbeat timestamp", "maxLength": 64 }
      },
      "required": ["sessionId", "hostUserId", "isPlaying", "volume", "isMuted"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile records"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "PlayerSettings",
      "description": "User configuration settings"
    },
    "/users/{userId}/customMedia/{mediaId}": {
      "schema": "CustomMedia",
      "description": "User saved custom media streams"
    },
    "/remoteSessions/{sessionId}": {
      "schema": "RemoteSession",
      "description": "Cloud remote control room for real-time sync across devices"
    }
  }
}
